{
  "title": "Carefolio",
  "description": "Méthodes de chargement du framework (EntityUtils, EntityBase) : rendent « voulus » les chargements qu'elles déclenchent. Appelant métier : code SIC, framework exclu.",
  "enabled": true,
  "appliesTo": [
    "*"
  ],
  "settings": {
    "callerPackages": [
      "ch.tecost.sic"
    ],
    "callerExclude": [
      "ch.tecost.framework."
    ],
    "accessExclude": [
      "new",
      "notNew",
      "managed",
      "deleted"
    ]
  },
  "probes": [
    {
      "id": "entity-utils",
      "handler": "method",
      "description": "Initialisations et rechargements explicites",
      "class": [
        "ch.tecost.framework.data.entity.utils.EntityUtils"
      ],
      "methods": [
        "initialize*",
        "unproxify",
        "reload",
        "loadByIds"
      ],
      "role": "load",
      "tags": [
        "entity-utils"
      ]
    },
    {
      "id": "entity-base",
      "handler": "method",
      "description": "Méthodes de chargement des entités",
      "class": [
        "ch.tecost.framework.data.entity.EntityBase"
      ],
      "methods": [
        "initialize*",
        "reload",
        "refresh",
        "load",
        "findByIds",
        "findAll"
      ],
      "role": "load",
      "tags": [
        "entity-base"
      ]
    }
  ]
}
